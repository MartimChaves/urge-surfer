  "notes": "One general list — every phrase has to work for any urge, so nothing here names a bet, a feed or a drink. Organized by Kristin Neff's three components of self-compassion, plus if-then implementation intentions (Gollwitzer). No closing full stop — it joins onto the last letter as a loop of extra ink rather than reading as punctuation. Keep phrases under 25 characters so a single phrase fits in a few minutes of weighted-tracing drawing. Only a-z, A-Z and space compose — commas and apostrophes throw. Avoid superlatives, worth-claims, and prescriptive demands. See CONTRIBUTING.md for review criteria.",
  "phrases": [
    { "text": "This is a hard moment",       "component": "mindfulness" },
    { "text": "I notice this urge",          "component": "mindfulness" },
    { "text": "This wave will pass",         "component": "mindfulness" },
    { "text": "Right now feels heavy",       "component": "mindfulness" },
    { "text": "I can sit with this",         "component": "mindfulness" },
    { "text": "The wave is here",            "component": "mindfulness" },
    { "text": "I am here breathing",         "component": "mindfulness" },
    { "text": "This moment will end",        "component": "mindfulness" },
    { "text": "This is a wave",              "component": "mindfulness" },
    { "text": "The urge is rising",          "component": "mindfulness" },
    { "text": "It crests and falls",         "component": "mindfulness" },
    { "text": "I am watching this",          "component": "mindfulness" },
    { "text": "This feeling has an end",     "component": "mindfulness" },
    { "text": "Here it comes again",         "component": "mindfulness" },
    { "text": "I feel it in my chest",       "component": "mindfulness" },
    { "text": "Nothing has to happen",       "component": "mindfulness" },
    { "text": "An urge is not an order",     "component": "mindfulness" },
    { "text": "I can watch it move",         "component": "mindfulness" },
    { "text": "This is passing through",     "component": "mindfulness" },
    { "text": "My feet are on the floor",    "component": "mindfulness" },
    { "text": "I notice wanting",            "component": "mindfulness" },
    { "text": "The peak is not forever",     "component": "mindfulness" },
    { "text": "So this is hard",             "component": "mindfulness" },
    { "text": "I am still breathing",        "component": "mindfulness" },
    { "text": "The wave has a shape",        "component": "mindfulness" },
    { "text": "It is loud right now",        "component": "mindfulness" },
    { "text": "Loud does not mean long",     "component": "mindfulness" },
    { "text": "I can name this urge",        "component": "mindfulness" },
    { "text": "Just this breath now",        "component": "mindfulness" },
    { "text": "The pull is a feeling",       "component": "mindfulness" },
    { "text": "Feelings are weather",        "component": "mindfulness" },
    { "text": "I stay and I watch",          "component": "mindfulness" },
    { "text": "This will not last",          "component": "mindfulness" },
    { "text": "My body is just busy",        "component": "mindfulness" },
    { "text": "I let it be here",            "component": "mindfulness" },
    { "text": "The urge can wait",           "component": "mindfulness" },
    { "text": "Wanting is not doing",        "component": "mindfulness" },
    { "text": "I am here for this",          "component": "mindfulness" },
    { "text": "I see the pull",              "component": "mindfulness" },
    { "text": "Nothing is decided yet",      "component": "mindfulness" },
    { "text": "This urge is here",           "component": "mindfulness" },
    { "text": "The itch is not the need",    "component": "mindfulness" },
    { "text": "I notice the pull",           "component": "mindfulness" },
    { "text": "The pull is just a pull",     "component": "mindfulness" },

    { "text": "Many feel this too",          "component": "common-humanity" },
    { "text": "I am not alone",              "component": "common-humanity" },
    { "text": "Others have stood here",      "component": "common-humanity" },
    { "text": "This is human",               "component": "common-humanity" },
    { "text": "We all have urges",           "component": "common-humanity" },
    { "text": "This pain is shared",         "component": "common-humanity" },
    { "text": "Many step back here",         "component": "common-humanity" },
    { "text": "This is part of living",      "component": "common-humanity" },
    { "text": "Many are awake with this",    "component": "common-humanity" },
    { "text": "Someone feels this now",      "component": "common-humanity" },
    { "text": "I am not the only one",       "component": "common-humanity" },
    { "text": "Others have surfed this",     "component": "common-humanity" },
    { "text": "This is an old struggle",     "component": "common-humanity" },
    { "text": "Every body does this",        "component": "common-humanity" },
    { "text": "I am in good company",        "component": "common-humanity" },
    { "text": "Millions know this hour",     "component": "common-humanity" },
    { "text": "This is not my flaw",         "component": "common-humanity" },
    { "text": "Struggle is not rare",        "component": "common-humanity" },
    { "text": "Others sit here tonight",     "component": "common-humanity" },
    { "text": "We all get pulled",           "component": "common-humanity" },
    { "text": "This is a human wave",        "component": "common-humanity" },
    { "text": "No one escapes urges",        "component": "common-humanity" },
    { "text": "Others have let it pass",     "component": "common-humanity" },
    { "text": "Being human is like this",    "component": "common-humanity" },
    { "text": "I share this with many",      "component": "common-humanity" },
    { "text": "This happens to us all",      "component": "common-humanity" },
    { "text": "My struggle is common",       "component": "common-humanity" },
    { "text": "Others surf this wave",       "component": "common-humanity" },
    { "text": "This is a known struggle",    "component": "common-humanity" },
    { "text": "I am one of many",            "component": "common-humanity" },
    { "text": "Many feel this itch",         "component": "common-humanity" },
    { "text": "The pull is built in",        "component": "common-humanity" },

    { "text": "I can be gentle",             "component": "self-kindness" },
    { "text": "May I be kind",               "component": "self-kindness" },
    { "text": "I will hold this softly",     "component": "self-kindness" },
    { "text": "Let me be patient",           "component": "self-kindness" },
    { "text": "I am safe to feel",           "component": "self-kindness" },
    { "text": "Slow is okay",                "component": "self-kindness" },
    { "text": "Breathe and rest",            "component": "self-kindness" },
    { "text": "I am with myself",            "component": "self-kindness" },
    { "text": "May I be gentle now",         "component": "self-kindness" },
    { "text": "Let me go slowly",            "component": "self-kindness" },
    { "text": "I can be soft here",          "component": "self-kindness" },
    { "text": "May I meet this kindly",      "component": "self-kindness" },
    { "text": "I can rest a moment",         "component": "self-kindness" },
    { "text": "Let me not rush",             "component": "self-kindness" },
    { "text": "I can ask for help",          "component": "self-kindness" },
    { "text": "May I hold this lightly",     "component": "self-kindness" },
    { "text": "Kindness is allowed",         "component": "self-kindness" },
    { "text": "I can take my time",          "component": "self-kindness" },
    { "text": "Let me breathe first",        "component": "self-kindness" },
    { "text": "I may be tired",              "component": "self-kindness" },
    { "text": "This is enough for now",      "component": "self-kindness" },
    { "text": "I can stop here",             "component": "self-kindness" },
    { "text": "Let me be easy on me",        "component": "self-kindness" },
    { "text": "May I have some peace",       "component": "self-kindness" },
    { "text": "I can put this down",         "component": "self-kindness" },
    { "text": "Gentle is still moving",      "component": "self-kindness" },
    { "text": "I can start over",            "component": "self-kindness" },
    { "text": "Let me tend to this",         "component": "self-kindness" },
    { "text": "I can care for myself",       "component": "self-kindness" },
    { "text": "Slow counts as moving",       "component": "self-kindness" },
    { "text": "May I settle a little",       "component": "self-kindness" },
    { "text": "I can hold my own hand",      "component": "self-kindness" },
    { "text": "Softness is not losing",      "component": "self-kindness" },
    { "text": "I can be on my side",         "component": "self-kindness" },
    { "text": "Let me choose comfort",       "component": "self-kindness" },
    { "text": "I can look after me",         "component": "self-kindness" },
    { "text": "May I be patient here",       "component": "self-kindness" },
    { "text": "Rest is not quitting",        "component": "self-kindness" },
    { "text": "Nothing needs fixing now",    "component": "self-kindness" },
    { "text": "My hands can be still",       "component": "self-kindness" },
    { "text": "This hour will end",          "component": "self-kindness" },
    { "text": "I can let this be hard",      "component": "self-kindness" },
    { "text": "Waves come down again",       "component": "self-kindness" },
    { "text": "My choice is mine",           "component": "self-kindness" },
    { "text": "The wave does not own me",    "component": "self-kindness" },
    { "text": "My calm is my own",           "component": "self-kindness" },
    { "text": "My time is mine to keep",     "component": "self-kindness" },

    { "text": "When it rises I breathe",     "component": "implementation-intention" },
    { "text": "When it comes I wait",        "component": "implementation-intention" },
    { "text": "If I feel it I sit",          "component": "implementation-intention" },
    { "text": "When it peaks I stay",        "component": "implementation-intention" },
    { "text": "If it starts I walk",         "component": "implementation-intention" },
    { "text": "When it calls I trace",       "component": "implementation-intention" },
    { "text": "If I want it I pause",        "component": "implementation-intention" },
    { "text": "When it hits I name it",      "component": "implementation-intention" },
    { "text": "If it rises I go slow",       "component": "implementation-intention" },
    { "text": "When it aches I stay put",    "component": "implementation-intention" },
    { "text": "If I reach I stop",           "component": "implementation-intention" },
    { "text": "When it burns I breathe",     "component": "implementation-intention" },
    { "text": "If it grows I sit down",      "component": "implementation-intention" },
    { "text": "When it pulls I stay",        "component": "implementation-intention" },
    { "text": "If it wakes me I rest",       "component": "implementation-intention" }
  ]
