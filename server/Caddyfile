# Static, privacy-respecting deployment. Compose sets SITE_ADDRESS to
# http://localhost in development and urgesurfer.surf in production.

{$SITE_ADDRESS:urgesurfer.surf} {
	root * /srv/urge-surfer/public
	encode zstd gzip
	file_server

	@static path *.json *.css *.js *.svg
	header @static Cache-Control "public, max-age=3600"

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
